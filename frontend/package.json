{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "tsc6 -b && bun run scripts/build.ts",
    "build-dev": "tsc6 -b && bun run scripts/build.ts --development",
    "lint": "eslint .",
    "lint:oxlint": "oxlint .",
    "test": "bun test tests/*.test.tsx tests/*.test.ts",
    "typecheck": "tsc6 -b tsconfig.app.json && tsc6 --noEmit -p tsconfig.tools.json",
    "preview": "bun run scripts/preview.ts",
    "test:browser": "cd tests/browser && xvfb-run --auto-servernum bun test .",
    "test:browser:axe": "cd tests/browser && xvfb-run --auto-servernum bun test ./accessibility-*.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "axe-core": "^4.13.0",
    "bun-plugin-tailwind": "^0.1.2",
    "jsdom": "^30.0.1",
    "oxlint": "^1.81.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
