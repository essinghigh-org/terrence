{
  // Extends the repo-root tsconfig (issue #428); frontend overrides below are
  // DOM/ES2020 targeting for the browser bundle. Everything strict inherits.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable", "ES2022.Object"],
    "module": "ESNext",
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    // Load-bearing (issue #429): third-party .d.ts files do not compile with
    // it off; first-party code is clean. See root tsconfig.json.
    "skipLibCheck": true
  },
  "include": ["src"]
}
