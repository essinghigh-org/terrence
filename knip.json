{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [],
  "ignoreDependencies": [],
  "ignoreExportsUsedInFile": true,
  "tags": [
    "-lintignore"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts"
      ]
    },
    "backend": {
      "entry": [
        "src/app.ts",
        "bench/**/*.ts",
        "seed.ts",
        "scripts/*.ts",
        "tests/**/*.ts",
        "drizzle.config.pg.ts",
        "src/db/pg-schema.ts",
        "src/lib/module-test-supervisor.ts"
      ]
    },
    "frontend": {
      "entry": [
        "src/main.tsx",
        "src/index.css",
        "src/App.tsx",
        "src/components/ui/*.tsx",
        "scripts/*.ts",
        "scripts/*.tsx",
        "tools/oxlint/**/*.ts",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "bench/**/*.ts"
      ]
    }
  },
  "ignoreBinaries": [
    "tsc",
    "tsc6"
  ]
}
