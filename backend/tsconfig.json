{
  // Extends the repo-root tsconfig (issue #428) so strict flags cannot drift.
  // Backend-specific overrides: NodeNext-style ESM emit semantics and
  // esModuleInterop for CJS interop. Everything else inherits from root.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // lib must repeat the tsc6 default for target ESNext (issue #428): the
    // root config sets lib ESNext-only, but backend code and @types/bun rely
    // on DOM globals (Request/Response/BodyInit). Without this, Bun's own
    // Response.json(): Promise<unknown> typing takes over and ~800
    // TS18046/TS2571/TS2322 errors appear in src and tests.
    "lib": ["ESNext", "DOM", "DOM.Iterable", "ScriptHost"],
    "module": "ESNext",
    "esModuleInterop": true,
    // Load-bearing (issue #429): ~177 third-party .d.ts errors (elysia) with
    // it off, zero in first-party code. See root tsconfig.json.
    "skipLibCheck": true
  },
  "include": ["src/**/*", "tests/**/*"]
}
