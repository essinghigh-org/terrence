diff --git a/internal/command/native_policy_admission_test.go b/internal/command/native_policy_admission_test.go
new file mode 100644
index 0000000..504fe05
--- /dev/null
+++ b/internal/command/native_policy_admission_test.go
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: BUSL-1.1
+
+package command
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// A strict owner is mandatory even when a local-only configuration could apply
+// without a provider download. Missing evidence ownership must stop before any
+// plan or state artifact exists, in either output format.
+func TestNativePolicyAdmissionRequiresOwner(t *testing.T) {
+	for _, operation := range []string{"plan", "apply", "init"} {
+		for _, jsonView := range []bool{false, true} {
+			name := operation
+			if jsonView {
+				name += "-json"
+			}
+			t.Run(name, func(t *testing.T) {
+				root := t.TempDir()
+				t.Chdir(root)
+				t.Setenv("TF_POLICY_AUDIT_NONCE", "")
+				t.Setenv("TF_POLICY_AUDIT_FD", "")
+				if err := os.WriteFile("main.tf", []byte(`resource "terraform_data" "proof" { input="local-only" }`), 0600); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.Mkdir("policies", 0700); err != nil {
+					t.Fatal(err)
+				}
+				t.Setenv("TF_POLICY_PLUGIN", filepath.Join(root, "missing-runtime"))
+				view, done := testView(t)
+				meta := Meta{View: view}
+				args := []string{"-strict-policy", "-policies=policies", "-input=false", "-no-color"}
+				if jsonView {
+					args = append(args, "-json")
+				}
+				var code int
+				switch operation {
+				case "plan":
+					code = (&PlanCommand{Meta: meta}).Run(append(args, "-out=proof.tfplan"))
+				case "apply":
+					code = (&ApplyCommand{Meta: meta}).Run(append(args, "-auto-approve"))
+				case "init":
+					code = (&InitCommand{Meta: meta}).Run(args)
+				}
+				output := done(t)
+				if code == 0 {
+					t.Fatalf("unowned strict execution succeeded:\n%s\n%s", output.Stdout(), output.Stderr())
+				}
+				for _, file := range []string{"proof.tfplan", "terraform.tfstate"} {
+					if _, err := os.Stat(file); !os.IsNotExist(err) {
+						t.Fatalf("unowned execution created %s", file)
+					}
+				}
+			})
+		}
+	}
+}
diff --git a/internal/command/native_policy_audit.go b/internal/command/native_policy_audit.go
new file mode 100644
index 0000000..f82a222
--- /dev/null
+++ b/internal/command/native_policy_audit.go
@@ -0,0 +1,460 @@
+// SPDX-License-Identifier: BUSL-1.1
+
+package command
+
+import (
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+
+	"github.com/hashicorp/terraform/internal/policy"
+	"github.com/hashicorp/terraform/internal/terraform"
+	"github.com/hashicorp/terraform/internal/tfdiags"
+)
+
+const nativePolicyAuditVersion = 1
+const nativePolicyAuditLimit = 16 << 20
+
+type nativePolicyOverride struct {
+	File    string `json:"file"`
+	Address string `json:"address"`
+}
+type nativePolicyResult struct {
+	File        string `json:"file"`
+	Address     string `json:"address"`
+	Enforcement string `json:"enforcement"`
+	Result      string `json:"result"`
+}
+type nativePolicyAuditRecord struct {
+	Version       int                      `json:"version"`
+	Sequence      int                      `json:"sequence"`
+	Nonce         string                   `json:"nonce"`
+	Command       string                   `json:"command"`
+	Event         string                   `json:"event"`
+	Phase         int                      `json:"phase"`
+	Stage         string                   `json:"stage,omitempty"`
+	Roots         []string                 `json:"roots,omitempty"`
+	Targets       []terraform.PolicyTarget `json:"targets,omitempty"`
+	Target        *terraform.PolicyTarget  `json:"target,omitempty"`
+	RequestSHA256 string                   `json:"requestSha256,omitempty"`
+	Result        string                   `json:"result,omitempty"`
+	Policies      []nativePolicyResult     `json:"policies,omitempty"`
+	Failed        bool                     `json:"failed"`
+	ExitCode      *int                     `json:"exitCode,omitempty"`
+	Overrides     []nativePolicyOverride   `json:"overrides,omitempty"`
+}
+
+// nativePolicyAudit owns a protected write-only descriptor. Descendants never
+// inherit it. It joins the graph inventory, exact RPC digests, and the final
+// command outcome; stdout and workspace files cannot substitute for this pipe.
+type nativePolicyAudit struct {
+	terraform.NilHook
+	mu           sync.Mutex
+	output       io.WriteCloser
+	planOutput   io.WriteCloser
+	nonce        string
+	command      string
+	roots        []string
+	overrides    map[nativePolicyOverride]bool
+	overrideList []nativePolicyOverride
+	sequence     int
+	bytes        int
+	phase        int
+	active       bool
+	setup        bool
+	denied       bool
+	failed       bool
+	poisoned     bool
+	ended        int
+	expected     map[terraform.PolicyTarget]int
+	observed     map[terraform.PolicyTarget]int
+	client       policy.Client
+}
+
+func newNativePolicyAudit(enabled bool, command string, roots []string) (*nativePolicyAudit, error) {
+	if !enabled {
+		return nil, nil
+	}
+	if len(roots) == 0 {
+		return nil, errors.New("-strict-policy requires at least one -policies directory")
+	}
+	nonce := os.Getenv("TF_POLICY_AUDIT_NONCE")
+	decoded, err := hex.DecodeString(nonce)
+	if err != nil || len(decoded) != 32 || nonce != strings.ToLower(nonce) {
+		return nil, errors.New("strict policy requires an owner nonce")
+	}
+	out, err := openNativePolicyAuditFD()
+	if err != nil {
+		return nil, err
+	}
+	audit := &nativePolicyAudit{output: out, nonce: nonce, command: command, roots: append([]string(nil), roots...), overrides: make(map[nativePolicyOverride]bool)}
+	for i, root := range audit.roots {
+		absolute, err := filepath.Abs(root)
+		if err != nil {
+			out.Close()
+			return nil, err
+		}
+		audit.roots[i] = filepath.Clean(absolute)
+	}
+	raw := os.Getenv("TF_POLICY_AUDIT_OVERRIDES")
+	if raw != "" {
+		if len(raw) > 32768 {
+			out.Close()
+			return nil, errors.New("native policy overrides exceed limit")
+		}
+		decoder := json.NewDecoder(strings.NewReader(raw))
+		decoder.DisallowUnknownFields()
+		if decoder.Decode(&audit.overrideList) != nil || len(audit.overrideList) > 1000 {
+			out.Close()
+			return nil, errors.New("invalid native policy overrides")
+		}
+		if decoder.Decode(new(any)) != io.EOF {
+			out.Close()
+			return nil, errors.New("trailing native policy override data")
+		}
+		for _, override := range audit.overrideList {
+			if override.Address == "" || !audit.policyFileAllowed(override.File) {
+				out.Close()
+				return nil, errors.New("native policy override is outside the immutable policy roots")
+			}
+			if audit.overrides[override] {
+				out.Close()
+				return nil, errors.New("duplicate native policy override")
+			}
+			audit.overrides[override] = true
+		}
+	}
+	if command == "plan" {
+		planOutput, err := openNativePolicyPlanFD()
+		if err != nil {
+			out.Close()
+			return nil, err
+		}
+		audit.planOutput = planOutput
+	}
+	if err := audit.write(nativePolicyAuditRecord{Event: "start", Roots: audit.roots, Overrides: audit.overrideList}); err != nil {
+		out.Close()
+		if audit.planOutput != nil {
+			audit.planOutput.Close()
+		}
+		return nil, err
+	}
+	return audit, nil
+}
+
+func (a *nativePolicyAudit) write(record nativePolicyAuditRecord) error {
+	if a.poisoned {
+		return errors.New("native policy evidence is poisoned")
+	}
+	record.Version = nativePolicyAuditVersion
+	record.Sequence = a.sequence
+	record.Nonce = a.nonce
+	record.Command = a.command
+	record.Phase = a.phase
+	encoded, err := json.Marshal(record)
+	if err != nil || a.sequence >= 100000 || a.bytes+len(encoded)+1 > nativePolicyAuditLimit {
+		a.poisoned = true
+		return errors.New("native policy evidence exceeds its bounded contract")
+	}
+	encoded = append(encoded, '\n')
+	n, err := a.output.Write(encoded)
+	if err != nil || n != len(encoded) {
+		a.poisoned = true
+		return errors.New("native policy evidence pipe failed")
+	}
+	a.sequence++
+	a.bytes += n
+	return nil
+}
+
+func (a *nativePolicyAudit) setupReady() error {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.setup {
+		a.poisoned = true
+		return errors.New("duplicate native policy Setup")
+	}
+	a.setup = true
+	return a.write(nativePolicyAuditRecord{Event: "setup"})
+}
+
+func validPolicyTarget(target terraform.PolicyTarget) bool {
+	if target.Address == "" || len(target.Address) > 4096 {
+		return false
+	}
+	switch target.Kind {
+	case "resource":
+		return target.Operation == "Create" || target.Operation == "Update" || target.Operation == "Delete" || target.Operation == "NoOp"
+	case "provider", "module":
+		return target.Operation == ""
+	default:
+		return false
+	}
+}
+
+func (a *nativePolicyAudit) expect(targets []terraform.PolicyTarget) error {
+	if len(targets) > 100000 {
+		return errors.New("native policy inventory exceeds limit")
+	}
+	for _, target := range targets {
+		if !validPolicyTarget(target) {
+			return errors.New("invalid native policy target")
+		}
+		a.expected[target]++
+	}
+	return nil
+}
+
+func (a *nativePolicyAudit) PolicyStart(stage string, targets []terraform.PolicyTarget) error {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if !a.setup || a.active {
+		a.poisoned = true
+		return errors.New("invalid native policy phase ordering")
+	}
+	if stage != "init" && stage != "walkPlan" && stage != "walkPlanDestroy" && stage != "walkApply" && stage != "walkDestroy" {
+		a.poisoned = true
+		return errors.New("unsupported native policy graph stage")
+	}
+	a.phase++
+	a.active = true
+	a.expected = make(map[terraform.PolicyTarget]int)
+	a.observed = make(map[terraform.PolicyTarget]int)
+	if err := a.expect(targets); err != nil {
+		a.poisoned = true
+		return err
+	}
+	return a.write(nativePolicyAuditRecord{Event: "begin", Stage: stage, Targets: targets})
+}
+
+func (a *nativePolicyAudit) PolicyExpect(targets []terraform.PolicyTarget) error {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if !a.active {
+		a.poisoned = true
+		return errors.New("policy inventory outside active phase")
+	}
+	if err := a.expect(targets); err != nil {
+		a.poisoned = true
+		return err
+	}
+	return a.write(nativePolicyAuditRecord{Event: "inventory", Targets: targets})
+}
+
+func (a *nativePolicyAudit) policyFileAllowed(file string) bool {
+	if !filepath.IsAbs(file) || filepath.Clean(file) != file {
+		return false
+	}
+	for _, root := range a.roots {
+		relative, err := filepath.Rel(root, file)
+		if err == nil && relative != "." && relative != ".." && !strings.HasPrefix(relative, ".."+string(filepath.Separator)) && !filepath.IsAbs(relative) {
+			return true
+		}
+	}
+	return false
+}
+
+func (a *nativePolicyAudit) classify(response policy.EvaluationResponse) (string, []nativePolicyResult) {
+	status := "passed"
+	details := make([]nativePolicyResult, 0, len(response.Policies))
+	promote := func(next string) {
+		rank := map[string]int{"passed": 0, "advisory": 1, "overridden": 2, "denied": 3, "unknown": 4, "error": 5}
+		if rank[next] > rank[status] {
+			status = next
+		}
+	}
+	denied := false
+	for _, p := range response.Policies {
+		if p == nil || !a.policyFileAllowed(p.Directory) || p.Address == "" {
+			promote("error")
+			continue
+		}
+		if p.EnforcementLevel != "advisory" && p.EnforcementLevel != "mandatory" && p.EnforcementLevel != "mandatory_overridable" {
+			promote("error")
+		}
+		details = append(details, nativePolicyResult{File: p.Directory, Address: p.Address, Enforcement: p.EnforcementLevel, Result: p.Result.String()})
+		switch p.Result {
+		case policy.AllowResult:
+		case policy.DenyResult:
+			denied = true
+			if p.EnforcementLevel == "advisory" {
+				promote("advisory")
+			} else if p.EnforcementLevel == "mandatory_overridable" && a.overrides[nativePolicyOverride{File: p.Directory, Address: p.Address}] {
+				promote("overridden")
+			} else {
+				promote("denied")
+			}
+		case policy.UnknownResult:
+			if p.EnforcementLevel == "advisory" {
+				promote("advisory")
+			} else {
+				promote("unknown")
+			}
+		default:
+			promote("error")
+		}
+	}
+	for _, enforcement := range response.Enforcements {
+		if enforcement.Policy == nil {
+			promote("error")
+			continue
+		}
+		switch enforcement.Result {
+		case policy.AllowResult:
+		case policy.DenyResult:
+			if enforcement.Policy.Result != policy.DenyResult {
+				promote("error")
+			}
+		case policy.UnknownResult:
+			if enforcement.Policy.Result != policy.UnknownResult {
+				promote("error")
+			}
+		default:
+			promote("error")
+		}
+	}
+	for _, diag := range response.Diagnostics {
+		if diag.Severity() != tfdiags.Error {
+			continue
+		}
+		extra, ok := diag.ExtraInfo().(*policy.PolicyExtra)
+		if !ok || extra.Result != policy.DenyResult || extra.Policy.Result != policy.DenyResult {
+			promote("error")
+		}
+	}
+	switch response.Overall {
+	case policy.AllowResult:
+		if status == "denied" || status == "unknown" {
+			promote("error")
+		}
+	case policy.DenyResult:
+		if !denied {
+			promote("error")
+		}
+	case policy.UnknownResult:
+		if len(response.Policies) == 0 {
+			promote("unknown")
+		}
+	default:
+		promote("error")
+	}
+	return status, details
+}
+
+func (a *nativePolicyAudit) PolicyEvaluated(target terraform.PolicyTarget, response policy.EvaluationResponse) error {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if !a.active || !validPolicyTarget(target) || a.observed[target] >= a.expected[target] {
+		a.poisoned = true
+		return errors.New("unexpected or duplicate native policy evaluation")
+	}
+	digest, err := hex.DecodeString(response.RequestSHA256)
+	if err != nil || len(digest) != 32 || response.RequestSHA256 != strings.ToLower(response.RequestSHA256) {
+		a.poisoned = true
+		return errors.New("native policy result lacks transport identity")
+	}
+	status, details := a.classify(response)
+	knownDenial := false
+	for _, p := range details {
+		if p.Result == "DenyResult" && (p.Enforcement == "mandatory" || p.Enforcement == "mandatory_overridable" && !a.overrides[nativePolicyOverride{File: p.File, Address: p.Address}]) {
+			knownDenial = true
+		}
+	}
+	// An UNKNOWN may defer only the unknown decision itself. Preserve a
+	// sibling's known, unapproved required denial as an independent blocker.
+	a.denied = a.denied || knownDenial
+	if status == "unknown" && a.command == "init" {
+		if knownDenial {
+			status = "denied"
+		} else {
+			status = "deferred"
+		}
+	}
+	a.observed[target]++
+	failed := status == "error" || status == "unknown" || status == "denied"
+	a.failed = a.failed || status == "error" || status == "unknown"
+	if err := a.write(nativePolicyAuditRecord{Event: "result", Target: &target, RequestSHA256: response.RequestSHA256, Result: status, Policies: details, Failed: failed}); err != nil {
+		return err
+	}
+	if status == "denied" {
+		a.denied = true
+		if a.command == "plan" {
+			return nil
+		}
+	}
+	if failed {
+		return fmt.Errorf("native policy evaluation %s for %s", status, target.Address)
+	}
+	return nil
+}
+
+func (a *nativePolicyAudit) PolicyEnd(failed bool) error {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if !a.active {
+		a.poisoned = true
+		return errors.New("native policy phase was not started")
+	}
+	missing := false
+	for target, count := range a.expected {
+		if a.observed[target] != count {
+			missing = true
+		}
+	}
+	if err := a.write(nativePolicyAuditRecord{Event: "end", Failed: failed || missing}); err != nil {
+		return err
+	}
+	a.active = false
+	a.ended++
+	a.failed = a.failed || failed || missing
+	if missing {
+		a.poisoned = true
+		return errors.New("native policy phase omitted expected evaluations")
+	}
+	return nil
+}
+
+func (a *nativePolicyAudit) finish(exitCode *int) {
+	if a == nil {
+		return
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.active || !a.setup || a.ended == 0 || a.poisoned || a.denied || a.failed {
+		*exitCode = 1
+	}
+	if a.planOutput != nil && a.planOutput.Close() != nil {
+		*exitCode = 1
+	}
+	if err := a.write(nativePolicyAuditRecord{Event: "complete", ExitCode: exitCode, Failed: *exitCode != 0 && *exitCode != 2}); err != nil {
+		*exitCode = 1
+	}
+	if a.output.Close() != nil {
+		*exitCode = 1
+	}
+}
+
+func (c *Meta) nativePolicyAdmission(enabled bool, command string, roots []string) (*nativePolicyAudit, policy.Diagnostics, func()) {
+	c.policyAudit = nil
+	audit, err := newNativePolicyAudit(enabled, command, roots)
+	closer := func() {}
+	if err != nil {
+		return nil, policy.Diagnostics{policy.NewErrorDiagnostic("Native policy admission failed", err.Error(), policy.SetupErrorResult)}, closer
+	}
+	if audit == nil {
+		return nil, nil, closer
+	}
+	c.policyAudit = audit
+	client, diags, stop := c.PolicyClient(c.CommandContext(), roots, nil)
+	if client == nil && !diags.HasErrors() {
+		diags = append(diags, policy.NewErrorDiagnostic("Native policy admission failed", "The requested native runtime was not initialized.", policy.SetupErrorResult))
+	}
+	audit.client = client
+	return audit, diags, stop
+}
