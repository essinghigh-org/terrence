+// SPDX-License-Identifier: BUSL-1.1
+package terraform
+
+import (
+	"github.com/hashicorp/terraform/internal/addrs"
+	"github.com/hashicorp/terraform/internal/configs"
+	"github.com/hashicorp/terraform/internal/policy"
+	"testing"
+)
+
+func TestNativePolicyModuleTraversalIncludesAllDescendants(t *testing.T) {
+	root := configs.NewEmptyConfig()
+	parent := root
+	for _, name := range []string{"child", "inner", "leaf"} {
+		path := append(append(addrs.Module{}, parent.Path...), name)
+		child := &configs.Config{Parent: parent, Root: root, Path: path, Module: &configs.Module{}, Children: map[string]*configs.Config{}}
+		parent.Children[name] = child
+		parent = child
+	}
+	g := &Graph{Path: addrs.RootModuleInstance}
+	transform := ModulePolicyTransformer{Config: root, PolicyClient: policy.NewTestMockClient(t)}
+	if err := transform.Transform(g); err != nil {
+		t.Fatal(err)
+	}
+	seen := map[string]bool{}
+	for vertex := range g.VerticesSeq() {
+		if node, ok := vertex.(*nodeModulePolicy); ok {
+			seen[node.Config.Path.String()] = true
+		}
+	}
+	for _, address := range []string{"module.child", "module.child.module.inner", "module.child.module.inner.module.leaf"} {
+		if !seen[address] {
+			t.Errorf("native module policy omitted %s", address)
+		}
+	}
+	if len(seen) != 3 {
+		t.Errorf("unexpected module policy count: %d", len(seen))
+	}
+}
