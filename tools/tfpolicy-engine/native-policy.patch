@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: BUSL-1.1
+
+package command
+
+import (
+	"errors"
+	"golang.org/x/sys/unix"
+	"os"
+)
+
+func openNativePolicyAuditFD() (*os.File, error) {
+	return openNativePolicyPipe("TF_POLICY_AUDIT_FD", "3", 3)
+}
+func openNativePolicyPlanFD() (*os.File, error) {
+	return openNativePolicyPipe("TF_POLICY_PLAN_FD", "4", 4)
+}
+func openNativePolicyPipe(env, expected string, fd uintptr) (*os.File, error) {
+	if os.Getenv(env) != expected {
+		return nil, errors.New("strict policy requires its private output descriptor")
+	}
+	file := os.NewFile(fd, "native-policy-output")
+	if file == nil {
+		return nil, errors.New("native audit descriptor missing")
+	}
+	flags, err := unix.FcntlInt(file.Fd(), unix.F_GETFL, 0)
+	if err != nil || flags&unix.O_ACCMODE != unix.O_WRONLY {
+		return nil, errors.New("native audit descriptor must be write-only")
+	}
+	info, err := file.Stat()
+	if err != nil || info.Mode()&os.ModeNamedPipe == 0 {
+		return nil, errors.New("native audit descriptor must be a pipe")
+	}
+	unix.CloseOnExec(int(fd))
+	return file, nil
+}
