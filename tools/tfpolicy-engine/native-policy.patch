diff --git a/internal/terraform/policy_audit.go b/internal/terraform/policy_audit.go
new file mode 100644
index 0000000..6a702bc
--- /dev/null
+++ b/internal/terraform/policy_audit.go
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: BUSL-1.1
+
+package terraform
+
+import (
+	"github.com/hashicorp/terraform/internal/policy"
+	"github.com/hashicorp/terraform/internal/tfdiags"
+	"sort"
+)
+
+// PolicyTarget identifies a native graph evaluation independently of whether a
+// policy matched it. Replacements have distinct create and delete targets.
+type PolicyTarget struct {
+	Kind      string `json:"kind"`
+	Address   string `json:"address"`
+	Operation string `json:"operation"`
+}
+
+// PolicyAuditHook is optional for ordinary CLI consumers. Strict owners use it
+// to receive the graph's expected inventory separately from observed results.
+// Resource expectations are added after resource expansion, before evaluation.
+type PolicyAuditHook interface {
+	PolicyStart(stage string, targets []PolicyTarget) error
+	PolicyExpect(targets []PolicyTarget) error
+	PolicyEvaluated(target PolicyTarget, result policy.EvaluationResponse) error
+	PolicyEnd(failed bool) error
+}
+
+func policyAuditHooks(hooks []Hook, fn func(PolicyAuditHook) error) tfdiags.Diagnostics {
+	var diags tfdiags.Diagnostics
+	for _, hook := range hooks {
+		if audit, ok := hook.(PolicyAuditHook); ok {
+			diags = diags.Append(fn(audit))
+		}
+	}
+	return diags
+}
+
+func policyAuditEvaluated(ctx EvalContext, target PolicyTarget, result policy.EvaluationResponse) error {
+	return ctx.Hook(func(h Hook) (HookAction, error) {
+		if audit, ok := h.(PolicyAuditHook); ok {
+			return HookActionContinue, audit.PolicyEvaluated(target, result)
+		}
+		return HookActionContinue, nil
+	})
+}
+
+func policyGraphMetadataTargets(graph *Graph) []PolicyTarget {
+	targets := make([]PolicyTarget, 0)
+	for vertex := range graph.VerticesSeq() {
+		switch node := vertex.(type) {
+		case *NodeApplyableProvider:
+			targets = append(targets, PolicyTarget{Kind: "provider", Address: node.Addr.String()})
+		case *nodeModulePolicy:
+			targets = append(targets, PolicyTarget{Kind: "module", Address: node.Config.Path.String()})
+		}
+	}
+	sortPolicyTargets(targets)
+	return targets
+}
+
+func sortPolicyTargets(targets []PolicyTarget) {
+	sort.Slice(targets, func(i, j int) bool {
+		a, b := targets[i], targets[j]
+		if a.Kind != b.Kind {
+			return a.Kind < b.Kind
+		}
+		if a.Address != b.Address {
+			return a.Address < b.Address
+		}
+		return a.Operation < b.Operation
+	})
+}
+
+func (ps *policySubgraph) auditTargets() []PolicyTarget {
+	ps.lock.Lock()
+	defer ps.lock.Unlock()
+	targets := make([]PolicyTarget, 0)
+	for vertex := range ps.graph.VerticesSeq() {
+		switch node := vertex.(type) {
+		case *nodeResourcePolicy:
+			if _, ok := policyOperationForAction(node.Action); ok {
+				targets = append(targets, PolicyTarget{Kind: "resource", Address: node.ResourceAddr.String(), Operation: node.Action.String()})
+			}
+		case *nodeQueryResourcePolicy:
+			targets = append(targets, PolicyTarget{Kind: "query", Address: node.ResourceAddr.String(), Operation: "read"})
+		}
+	}
+	sortPolicyTargets(targets)
+	return targets
+}
