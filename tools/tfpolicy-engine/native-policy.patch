+	encoded, err := (pb.MarshalOptions{Deterministic: true}).Marshal(request)
+	if err != nil {
+		r.Overall = PolicyErrorResult
+		r.Diagnostics = append(r.Diagnostics, NewErrorDiagnostic("Invalid policy request", "The native policy request could not be hashed.", PolicyErrorResult))
