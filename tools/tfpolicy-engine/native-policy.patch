@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: BUSL-1.1
+package command
+
+import (
+	"context"
+	"fmt"
+	"github.com/hashicorp/terraform/internal/addrs"
+	"github.com/hashicorp/terraform/internal/command/views"
+	"github.com/hashicorp/terraform/internal/configs"
+	"github.com/hashicorp/terraform/internal/policy"
+	"github.com/hashicorp/terraform/internal/policy/proto"
+	"testing"
+)
+
+type nativeInitPolicyView struct{ views.Init }
+
+func (*nativeInitPolicyView) PolicyResult(string, policy.EvaluationResponse) {}
+
+// Exercise the production installation hooks, whose return value is the
+// installer's blocking signal. An unknown sibling must never erase a known
+// unapproved required denial, independent of the plugin's policy ordering.
+func TestNativePolicyInitHooksKeepKnownDenialWithUnknown(t *testing.T) {
+	for _, kind := range []string{"provider", "module"} {
+		for _, level := range []string{"mandatory", "mandatory_overridable", "approved", "advisory", "pure-unknown"} {
+			for _, reverse := range []bool{false, true} {
+				t.Run(fmt.Sprintf("%s/%s/reverse=%t", kind, level, reverse), func(t *testing.T) {
+					audit, _, file := testNativeAudit(t, "init")
+					if err := audit.PolicyStart("init", nil); err != nil {
+						t.Fatal(err)
+					}
+					unknown := &policy.Policy{Directory: file, Address: kind + "_policy.unknown", EnforcementLevel: "mandatory", Result: policy.UnknownResult}
+					denial := &policy.Policy{Directory: file, Address: kind + "_policy.known", EnforcementLevel: level, Result: policy.DenyResult}
+					if level == "approved" {
+						denial.EnforcementLevel = "mandatory_overridable"
+						audit.overrides[nativePolicyOverride{File: file, Address: denial.Address}] = true
+					}
+					response := auditTestResponse(file, policy.DenyResult, "mandatory")
+					response.Policies = []*policy.Policy{denial, unknown}
+					if reverse {
+						response.Policies = []*policy.Policy{unknown, denial}
+					}
+					if level == "pure-unknown" {
+						response.Overall = policy.UnknownResult
+						response.Policies = []*policy.Policy{unknown}
+					}
+					client := policy.NewTestMockClient(t)
+					client.EvaluateProviderFn = func(context.Context, policy.EvaluationRequest[*proto.PolicyEvaluateProviderRequest_ProviderMetadata]) policy.EvaluationResponse {
+						return response
+					}
+					client.EvaluateModuleFn = func(context.Context, policy.EvaluationRequest[*proto.PolicyEvaluateModuleRequest_ModuleMetadata]) policy.EvaluationResponse {
+						return response
+					}
+					blocked := false
+					if kind == "provider" {
+						hook := &providerPolicyHook{audit: audit, client: client, rootModule: &configs.Module{}, view: &nativeInitPolicyView{}}
+						blocked = hook.ProviderVersionSelected(context.Background(), addrs.NewDefaultProvider("test"), "1.0.0") != nil
+					} else {
+						hook := &policyModuleInstallHook{audit: audit, client: client, view: &nativeInitPolicyView{}}
+						blocked = hook.ModuleSourceResolved(context.Background(), &configs.ModuleRequest{Path: addrs.Module{"child"}, Name: "child", SourceAddr: addrs.ModuleSourceLocal("./child")}, "").HasErrors()
+					}
+					want := level == "mandatory" || level == "mandatory_overridable"
+					if blocked != want || audit.denied != want {
+						t.Errorf("installation blocked=%t audit.denied=%t, want %t", blocked, audit.denied, want)
+					}
+					if err := audit.PolicyEnd(false); err != nil {
+						t.Fatal(err)
+					}
+					code := 0
+					audit.finish(&code)
+					if (code != 0) != want {
+						t.Errorf("init exit=%d, denial required=%t", code, want)
+					}
+				})
+			}
+		}
+	}
+}
