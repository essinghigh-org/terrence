// Test-only native protocol fixture. This is not a Terraform policy evaluator.
package main

import (
	"context"
	"encoding/json"
	"errors"
	"os"
	"os/exec"
	"path/filepath"
	"runtime"
	"strings"
	"syscall"
	"time"

	"github.com/hashicorp/go-plugin"
	"github.com/zclconf/go-cty/cty"
	"github.com/zclconf/go-cty/cty/msgpack"
	p "github.com/hashicorp/terraform/internal/policy/proto"
	"google.golang.org/grpc"
)

var handshake = plugin.HandshakeConfig{ProtocolVersion: 1, MagicCookieKey: "TF_POLICY_PLUGIN", MagicCookieValue: "6F11ED78A2AB"}

type config struct {
	Mode          string `json:"mode"`
	ForbiddenPath string `json:"forbidden_path"`
	Enforcement string `json:"enforcement"`
	RequireContext bool `json:"require_context"`
}
type server struct {
	p.UnimplementedPolicyServer
	c config
	policyFile string
}

func probe(path string) error {
	if _, e := os.ReadFile(path); e == nil {
		return errors.New("sandbox exposed forbidden canary")
	}
	if runtime.GOARCH != "amd64" && runtime.GOARCH != "arm64" {
		return errors.New("unsupported probe architecture")
	}
	// pidfd_getfd is syscall 438 on these architectures. Invalid fd would produce
	// EBADF without the mandatory seccomp filter, not EPERM. No fd is duplicated.
	_, _, e := syscall.RawSyscall(438, ^uintptr(0), 0, 0)
	if e != syscall.EPERM {
		return errors.New("debug syscall was not filtered")
	}
	return nil
}
func (s *server) Setup(_ context.Context, r *p.PolicySetupRequest) (*p.PolicySetupResponse, error) {
	if len(r.SourceLocations) != 1 {
		return nil, errors.New("fixture expects one root")
	}
	b, e := os.ReadFile(filepath.Join(r.SourceLocations[0], "fixture.json"))
	if e != nil {
		return nil, e
	}
	if e = json.Unmarshal(b, &s.c); e != nil {
		return nil, e
	}
	s.policyFile=filepath.Join(r.SourceLocations[0],"fixture.policy.hcl")
	if s.c.Enforcement==""{s.c.Enforcement="mandatory"}
	if s.c.RequireContext && (r.Entitlement==nil || r.Entitlement.Host!="terrence.example" || r.Entitlement.Org!="owner-tests" || r.Entitlement.Token!="private-run-token"){return nil,errors.New("trusted entitlement context missing")}
	if s.c.RequireContext{for _,env:=range os.Environ(){if strings.Contains(env,r.Entitlement.Token){return nil,errors.New("trusted entitlement entered child environment")}}}
	if os.Getenv("TFPOLICY_JOURNAL_FD") != "" || os.Getenv("TFPOLICY_RECORDER_CONFIG") != "" || os.Getenv("TFPOLICY_RUN_NONCE") != "" {
		return nil, errors.New("private recorder env leaked")
	}
	var st syscall.Stat_t
	if syscall.Fstat(3, &st) == nil && st.Mode&syscall.S_IFMT == syscall.S_IFIFO {
		return nil, errors.New("private journal pipe leaked")
	}
	if syscall.Fstat(5, &st) == nil && st.Mode&syscall.S_IFMT == syscall.S_IFREG {
		return nil, errors.New("private config file leaked")
	}
	if e = probe(s.c.ForbiddenPath); e != nil {
		return nil, e
	}
	if s.c.Mode == "setup-error" {
		return nil, errors.New("expected fixture setup failure")
	}
	if s.c.Mode == "orphan" {
		child := exec.Command(os.Args[0], "orphan-child")
		child.SysProcAttr = &syscall.SysProcAttr{Setsid: true}
		if e = child.Start(); e != nil {
			return nil, e
		}
	}
	return &p.PolicySetupResponse{}, nil
}
func detail(file string,enforcement string,deny bool) []*p.PolicyEvaluationDetail {
	result := p.EvaluateResult_ALLOW_EVALUATE_RESULT
	var diagnostics []*p.Diagnostic
	if deny {
		result = p.EvaluateResult_DENY_EVALUATE_RESULT
		diagnostics = []*p.Diagnostic{{Severity: p.Severity_ERROR, Summary: "Native integration fixture denied", Detail: "Expected test-only deny result.", Result: &p.DiagnosticResult{Result: result}}}
	}
	return []*p.PolicyEvaluationDetail{{File:file,Address: "fixture.integration", Result: result, PolicySetName: "integration", PolicySetEnforcement: enforcement, Diagnostics: diagnostics, EnforceResults: []*p.EnforceBlockResult{{Result: result, ConditionPassed: !deny, Diagnostics: diagnostics}}}}
}
func (s *server) EvaluateResource(_ context.Context,req *p.PolicyEvaluateResourceRequest) (*p.PolicyEvaluateResourceResponse, error) {
	switch s.c.Mode {
	case "crash":
		os.Exit(23)
	case "hang":
		time.Sleep(90 * time.Second)
	}
	deny := s.c.Mode == "deny"
	if s.c.Mode=="apply-deny" || s.c.Mode=="apply-crash" || s.c.Mode=="apply-hang" {
		if req.Attrs==nil{return nil,errors.New("fixture attributes missing")}
		value,err:=msgpack.Unmarshal(req.Attrs.Raw,cty.DynamicPseudoType);if err!=nil{return nil,errors.New("fixture attributes invalid")}
		if value.Type().IsObjectType() && value.Type().HasAttribute("id") && value.GetAttr("id").IsKnown() && !value.GetAttr("id").IsNull(){switch s.c.Mode{case "apply-deny":deny=true;case "apply-crash":os.Exit(23);case "apply-hang":time.Sleep(90*time.Second)}}
	}
	result := p.EvaluateResult_ALLOW_EVALUATE_RESULT
	if deny {
		result = p.EvaluateResult_DENY_EVALUATE_RESULT
	}
	return &p.PolicyEvaluateResourceResponse{Result: result, PolicyDetails: detail(s.policyFile,s.c.Enforcement,deny)}, nil
}
func (s *server) EvaluateProvider(context.Context, *p.PolicyEvaluateProviderRequest) (*p.PolicyEvaluateProviderResponse, error) {
	return &p.PolicyEvaluateProviderResponse{Result: p.EvaluateResult_ALLOW_EVALUATE_RESULT, PolicyDetails: detail(s.policyFile,"mandatory",false)}, nil
}
func (s *server) EvaluateModule(context.Context, *p.PolicyEvaluateModuleRequest) (*p.PolicyEvaluateModuleResponse, error) {
	if strings.HasPrefix(s.c.Mode,"init-") {
		unknown:=detail(s.policyFile,"mandatory",false)[0]
		unknown.Address="fixture.unknown";unknown.Result=p.EvaluateResult_UNKNOWN_EVALUATE_RESULT
		unknown.EnforceResults=[]*p.EnforceBlockResult{{Result:p.EvaluateResult_UNKNOWN_EVALUATE_RESULT}}
		if s.c.Mode=="init-unknown" {return &p.PolicyEvaluateModuleResponse{Result:p.EvaluateResult_UNKNOWN_EVALUATE_RESULT,PolicyDetails:[]*p.PolicyEvaluationDetail{unknown}},nil}
		known:=detail(s.policyFile,s.c.Enforcement,true)[0];known.Address="fixture.known"
		details:=[]*p.PolicyEvaluationDetail{known,unknown}
		if strings.HasSuffix(s.c.Mode,"reverse"){details[0],details[1]=details[1],details[0]}
		return &p.PolicyEvaluateModuleResponse{Result:p.EvaluateResult_DENY_EVALUATE_RESULT,PolicyDetails:details},nil
	}
	return &p.PolicyEvaluateModuleResponse{Result: p.EvaluateResult_ALLOW_EVALUATE_RESULT, PolicyDetails: detail(s.policyFile,"mandatory",false)}, nil
}

type transport struct{ plugin.NetRPCUnsupportedPlugin }

func (*transport) GRPCServer(_ *plugin.GRPCBroker, g *grpc.Server) error {
	p.RegisterPolicyServer(g, &server{})
	return nil
}
func (*transport) GRPCClient(context.Context, *plugin.GRPCBroker, *grpc.ClientConn) (interface{}, error) {
	return nil, errors.New("fixture server only")
}
func main() {
	if len(os.Args) == 2 && os.Args[1] == "orphan-child" {
		time.Sleep(90 * time.Second)
		return
	}
	if len(os.Args) == 3 && os.Args[1] == "sandbox-probe" {
		if probe(os.Args[2]) != nil {
			os.Exit(4)
		}
		return
	}
	if len(os.Args) != 2 || os.Args[1] != "rpcapi" {
		os.Exit(2)
	}
	plugin.Serve(&plugin.ServeConfig{HandshakeConfig: handshake, Plugins: map[string]plugin.Plugin{"policy": &transport{}}, GRPCServer: plugin.DefaultGRPCServer})
}
