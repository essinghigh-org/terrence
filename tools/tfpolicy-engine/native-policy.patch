index 0000000..e0ddc2a
--- /dev/null
+++ b/internal/command/native_policy_plan_fd_linux_test.go
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: BUSL-1.1
+
+package command
+
+import (
+	"bytes"
+	"golang.org/x/sys/unix"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+)
+
+func TestNativePolicyPlanPipeDescriptor(t *testing.T) {
+	if mode := os.Getenv("TF_TEST_NATIVE_PLAN_PIPE"); mode != "" {
+		file, err := openNativePolicyPlanFD()
+		if mode != "valid" {
+			if err == nil {
+				os.Exit(1)
+			}
+			os.Exit(0)
+		}
+		if err != nil {
+			os.Exit(2)
+		}
+		flags, err := unix.FcntlInt(file.Fd(), unix.F_GETFD, 0)
+		if err != nil || flags&unix.FD_CLOEXEC == 0 {
+			os.Exit(3)
+		}
+		if _, err = file.Write([]byte("owned-plan-output\n")); err != nil {
+			os.Exit(4)
+		}
+		if file.Close() != nil {
+			os.Exit(5)
+		}
+		os.Exit(0)
+	}
+	for _, mode := range []string{"missing", "read-only", "regular", "valid"} {
+		t.Run(mode, func(t *testing.T) {
+			read, write, err := os.Pipe()
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer read.Close()
+			defer write.Close()
+			null, err := os.Open("/dev/null")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer null.Close()
+			fd := write
+			if mode == "read-only" {
+				fd = read
+			}
+			if mode == "regular" {
+				fd, err = os.OpenFile(filepath.Join(t.TempDir(), "plan"), os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer fd.Close()
+			}
+			cmd := exec.Command(os.Args[0], "-test.run=^TestNativePolicyPlanPipeDescriptor$")
+			cmd.Env = []string{"PATH=/usr/bin:/bin", "TF_TEST_NATIVE_PLAN_PIPE=" + mode}
+			if mode != "missing" {
+				cmd.Env = append(cmd.Env, "TF_POLICY_PLAN_FD=4")
+			}
+			cmd.ExtraFiles = []*os.File{null, fd}
+			if output, err := cmd.CombinedOutput(); err != nil {
+				t.Fatalf("protected descriptor control failed: %v %s", err, output)
+			}
+			write.Close()
+			if mode == "valid" {
+				output, err := io.ReadAll(read)
+				if err != nil || !bytes.Equal(output, []byte("owned-plan-output\n")) {
+					t.Fatal("plan stream changed", err)
+				}
+			}
+		})
+	}
+}
