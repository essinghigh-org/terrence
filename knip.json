{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [],
  "ignoreDependencies": [
    "shadcn"
  ],
  "ignoreExportsUsedInFile": true,
  "tags": [
    "-lintignore"
  ],
  "workspaces": {
    ".": {},
    "backend": {
      "entry": [
        "src/app.ts",
        "bench/**/*.ts",
        "seed.ts",
        "scripts/*.ts",
        "tests/**/*.ts",
        "drizzle.config.pg.ts",
        "src/db/pg-schema.ts",
        "src/lib/module-test-supervisor.ts"
      ]
    },
    "frontend": {
      "entry": [
        "src/App.tsx",
        "src/components/ui/*.tsx",
        "tools/oxlint/**/*.ts",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "bench/**/*.ts"
      ]
    }
  }
}
