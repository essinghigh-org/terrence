# =============================================================================
# Terrence — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust as needed. The app works out of the box
# with the default values — no environment variables are required for a
# basic local setup with SQLite.
# =============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000                                     # Backend HTTP port
PUBLIC_URL=http://localhost:3000               # Public-facing URL (webhooks, links)
NODE_ENV=development                          # "development" | "production" | "test"
CORS_ORIGIN=*                                 # Allowed CORS origin (set in production)

# ── Storage & Database ──────────────────────────────────────────────────────
STORAGE_DIR=./backend/storage                 # Directory for SQLite DB, binaries, artifacts
DATABASE_URL=file:./backend/storage/terrence.db # SQLite connection string

# ── Admin Bootstrap ─────────────────────────────────────────────────────────
# Set these to auto-configure an initial admin user on first start.
# After bootstrapping, remove IACT_TOKEN to disable the bootstrap endpoint.
IACT_TOKEN=                                   # Bootstrap authentication token (string)
ADMIN_USERNAME=admin                          # Initial admin username
ADMIN_PASSWORD=password                       # Initial admin password (change immediately!)
ADMIN_ORGANIZATION=default                    # Default organization name

# ── VCS Integration (GitHub App) ────────────────────────────────────────────
GITHUB_APP_ID=                                # GitHub App ID
GITHUB_APP_SLUG=                              # GitHub App slug
GITHUB_APP_PRIVATE_KEY=                       # RSA private key (use \n for newlines)
GITHUB_WEBHOOK_SECRET=                        # Webhook secret
GITHUB_APP_HTTP_URL=https://github.com        # GitHub HTTP base URL (GHES)
GITHUB_APP_API_URL=https://api.github.com     # GitHub API base URL (GHES)
GITHUB_API_URL=                               # GitHub API URL (alternative for webhooks)

# ── VCS Integration (GitLab) ────────────────────────────────────────────────
GITLAB_WEBHOOK_SECRET=                        # GitLab webhook secret

# ── VCS Integration (Bitbucket) ─────────────────────────────────────────────
BITBUCKET_WEBHOOK_SECRET=                     # Bitbucket webhook secret

# ── Run Execution ───────────────────────────────────────────────────────────
SIMULATED_RUNS=false                          # Use simulated plan output (for testing)
SIMULATED_PLAN_JSON={}                        # Mock plan JSON for simulated runs
ALLOW_TOOL_FALLBACK=false                     # Fall back to system tofu/terraform
ALLOW_UNVERIFIED_CHECKSUMS=false              # Skip SHA256 verification of binaries
RUN_TASK_TIMEOUT_MS=3600000                   # Run task execution timeout (ms)
SENTINEL_BINARY_PATH=sentinel                 # Path to Sentinel binary (policy-as-code)
HEALTH_ASSESSMENT_INTERVAL_MS=86400000        # Health assessment interval (ms)
HEALTH_ASSESSMENT_CONCURRENCY=2               # Parallel health assessment workers
CLI_TOKEN_TTL_MS=                             # CLI authentication token TTL (ms)

# ── Security ────────────────────────────────────────────────────────────────
ENCRYPTION_PASSWORD=                          # Password for encrypting sensitive DB fields
SESSION_KEY=                                  # Session encryption key (auto-generated if empty)

# ── Build Info ──────────────────────────────────────────────────────────────
BUILD_VERSION=dev                             # Release version (Docker build)
BUILD_SHA=unknown                             # Git commit SHA (Docker build)
