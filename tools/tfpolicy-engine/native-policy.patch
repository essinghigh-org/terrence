diff --git a/internal/command/native_policy_audit_test.go b/internal/command/native_policy_audit_test.go
new file mode 100644
index 0000000..559bb63
--- /dev/null
+++ b/internal/command/native_policy_audit_test.go
@@ -0,0 +1,210 @@
+// SPDX-License-Identifier: BUSL-1.1
+
+package command
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/hashicorp/terraform/internal/policy"
+	"github.com/hashicorp/terraform/internal/terraform"
+)
+
+type auditTestOutput struct {
+	bytes.Buffer
+	fail   bool
+	closed bool
+}
+
+func (o *auditTestOutput) Write(data []byte) (int, error) {
+	if o.fail {
+		return 0, errors.New("closed owner pipe")
+	}
+	return o.Buffer.Write(data)
+}
+func (o *auditTestOutput) Close() error { o.closed = true; return nil }
+func testNativeAudit(t *testing.T, command string) (*nativePolicyAudit, *auditTestOutput, string) {
+	t.Helper()
+	root := t.TempDir()
+	out := &auditTestOutput{}
+	audit := &nativePolicyAudit{output: out, command: command, nonce: strings.Repeat("a", 64), roots: []string{root}, overrides: make(map[nativePolicyOverride]bool)}
+	if err := audit.write(nativePolicyAuditRecord{Event: "start", Roots: audit.roots}); err != nil {
+		t.Fatal(err)
+	}
+	if err := audit.setupReady(); err != nil {
+		t.Fatal(err)
+	}
+	return audit, out, filepath.Join(root, "proof.policy.hcl")
+}
+func auditTestTarget() terraform.PolicyTarget {
+	return terraform.PolicyTarget{Kind: "resource", Address: "terraform_data.proof", Operation: "Create"}
+}
+func auditTestResponse(file string, result policy.EvaluateResult, level string) policy.EvaluationResponse {
+	return policy.EvaluationResponse{Overall: result, RequestSHA256: strings.Repeat("b", 64), Policies: []*policy.Policy{{Directory: file, Address: "resource_policy.proof", EnforcementLevel: level, Result: result}}}
+}
+func TestNativePolicyAuditLifecycle(t *testing.T) {
+	audit, out, file := testNativeAudit(t, "plan")
+	target := auditTestTarget()
+	if err := audit.PolicyStart("walkPlan", nil); err != nil {
+		t.Fatal(err)
+	}
+	if err := audit.PolicyExpect([]terraform.PolicyTarget{target}); err != nil {
+		t.Fatal(err)
+	}
+	if err := audit.PolicyEvaluated(target, auditTestResponse(file, policy.AllowResult, "mandatory")); err != nil {
+		t.Fatal(err)
+	}
+	if err := audit.PolicyEnd(false); err != nil {
+		t.Fatal(err)
+	}
+	code := 0
+	audit.finish(&code)
+	if code != 0 || !out.closed {
+		t.Fatal("successful lifecycle failed")
+	}
+	lines := bytes.Split(bytes.TrimSpace(out.Bytes()), []byte{'\n'})
+	if len(lines) != 7 {
+		t.Fatalf("records: %d", len(lines))
+	}
+	for i, line := range lines {
+		var record nativePolicyAuditRecord
+		if json.Unmarshal(line, &record) != nil || record.Sequence != i || record.Nonce != audit.nonce {
+			t.Fatal("invalid ordered evidence")
+		}
+	}
+	if !bytes.Contains(lines[4], []byte(`"requestSha256"`)) || !bytes.Contains(lines[6], []byte(`"event":"complete"`)) {
+		t.Fatal("transport identity/completion omitted")
+	}
+}
+func TestNativePolicyAuditDecisions(t *testing.T) {
+	for _, test := range []struct {
+		name, command, level   string
+		result                 policy.EvaluateResult
+		override, graphFailure bool
+		exit                   int
+	}{
+		{"allow", "plan", "mandatory", policy.AllowResult, false, false, 0},
+		{"advisory", "apply", "advisory", policy.DenyResult, false, false, 0},
+		{"plan-denied", "plan", "mandatory", policy.DenyResult, false, false, 1},
+		{"apply-denied", "apply", "mandatory", policy.DenyResult, false, true, 1},
+		{"overridable-unapproved", "plan", "mandatory_overridable", policy.DenyResult, false, false, 1},
+		{"overridable-approved", "apply", "mandatory_overridable", policy.DenyResult, true, false, 0},
+		{"mandatory-cannot-override", "apply", "mandatory", policy.DenyResult, true, true, 1},
+		{"unknown", "plan", "mandatory", policy.UnknownResult, false, true, 1},
+		{"init-deferred", "init", "mandatory", policy.UnknownResult, false, false, 0},
+		{"advisory-unknown", "apply", "advisory", policy.UnknownResult, false, false, 0},
+		{"runtime-error", "plan", "advisory", policy.PolicyErrorResult, true, true, 1},
+		{"invalid", "plan", "mandatory", policy.InvalidResult, false, true, 1},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			audit, _, file := testNativeAudit(t, test.command)
+			target := auditTestTarget()
+			if test.override {
+				audit.overrides[nativePolicyOverride{File: file, Address: "resource_policy.proof"}] = true
+			}
+			if err := audit.PolicyStart("walkPlan", []terraform.PolicyTarget{target}); err != nil {
+				t.Fatal(err)
+			}
+			err := audit.PolicyEvaluated(target, auditTestResponse(file, test.result, test.level))
+			if (err != nil) != test.graphFailure {
+				t.Fatalf("graph failure: %v", err)
+			}
+			if err := audit.PolicyEnd(test.graphFailure); err != nil {
+				t.Fatal(err)
+			}
+			code := 0
+			if test.graphFailure {
+				code = 1
+			}
+			audit.finish(&code)
+			if code != test.exit {
+				t.Fatalf("exit %d, want %d", code, test.exit)
+			}
+		})
+	}
+}
+func TestNativePolicyAuditRejectsMissingOrForgedResults(t *testing.T) {
+	for _, mode := range []string{"missing", "duplicate", "unexpected", "missing-digest", "outside-source", "failed-pipe"} {
+		t.Run(mode, func(t *testing.T) {
+			audit, out, file := testNativeAudit(t, "plan")
+			target := auditTestTarget()
+			if err := audit.PolicyStart("walkPlan", []terraform.PolicyTarget{target}); err != nil {
+				t.Fatal(err)
+			}
+			response := auditTestResponse(file, policy.AllowResult, "mandatory")
+			switch mode {
+			case "missing":
+				if audit.PolicyEnd(false) == nil {
+					t.Fatal("omitted target accepted")
+				}
+			case "duplicate":
+				if err := audit.PolicyEvaluated(target, response); err != nil {
+					t.Fatal(err)
+				}
+				if audit.PolicyEvaluated(target, response) == nil {
+					t.Fatal("duplicate accepted")
+				}
+			case "unexpected":
+				target.Address = "terraform_data.other"
+				if audit.PolicyEvaluated(target, response) == nil {
+					t.Fatal("unregistered target accepted")
+				}
+			case "missing-digest":
+				response.RequestSHA256 = ""
+				if audit.PolicyEvaluated(target, response) == nil {
+					t.Fatal("unbound result accepted")
+				}
+			case "outside-source":
+				response.Policies[0].Directory = "/outside/proof.policy.hcl"
+				if audit.PolicyEvaluated(target, response) == nil {
+					t.Fatal("outside policy accepted")
+				}
+			case "failed-pipe":
+				out.fail = true
+				if audit.PolicyEvaluated(target, response) == nil {
+					t.Fatal("lost evidence accepted")
+				}
+			}
+			code := 0
+			audit.finish(&code)
+			if code == 0 {
+				t.Fatal("invalid evidence returned success")
+			}
+		})
+	}
+}
+func TestNativePolicyAuditDoesNotSerializeAttributesOrMessages(t *testing.T) {
+	audit, out, file := testNativeAudit(t, "plan")
+	target := auditTestTarget()
+	audit.PolicyStart("walkPlan", []terraform.PolicyTarget{target})
+	response := auditTestResponse(file, policy.AllowResult, "mandatory")
+	response.Enforcements = []policy.EnforcementResult{{Result: policy.AllowResult, Policy: response.Policies[0], Message: "sensitive-attribute-value"}}
+	if err := audit.PolicyEvaluated(target, response); err != nil {
+		t.Fatal(err)
+	}
+	audit.PolicyEnd(false)
+	code := 0
+	audit.finish(&code)
+	if bytes.Contains(out.Bytes(), []byte("sensitive-attribute-value")) {
+		t.Fatal("private value leaked into audit records")
+	}
+}
+
+func TestNativePolicyAuditRemembersPhaseFailure(t *testing.T) {
+	audit, _, _ := testNativeAudit(t, "plan")
+	if err := audit.PolicyStart("walkPlan", nil); err != nil {
+		t.Fatal(err)
+	}
+	if err := audit.PolicyEnd(true); err != nil {
+		t.Fatal(err)
+	}
+	code := 0
+	audit.finish(&code)
+	if code == 0 {
+		t.Fatal("failed phase became a successful command")
+	}
+}
