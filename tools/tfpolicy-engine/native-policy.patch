@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: BUSL-1.1
+
+package command
+
+import (
+	"encoding/json"
+	"github.com/hashicorp/terraform/version"
+	"runtime"
+)
+
+// NativePolicyPatchSHA256 is set by the source-build recipe. Runtime owners pin
+// the executable checksum as well as this source provenance; the descriptor
+// alone never authorizes a binary or a run.
+var NativePolicyPatchSHA256 string
+
+type NativePolicyContractCommand struct{ Meta }
+
+func (c *NativePolicyContractCommand) Help() string {
+	return "Report the native policy owner contract as JSON."
+}
+func (c *NativePolicyContractCommand) Synopsis() string {
+	return "Report the native policy owner contract"
+}
+func (c *NativePolicyContractCommand) Run(args []string) int {
+	if len(args) != 0 {
+		c.Ui.Error("native-policy-contract accepts no arguments")
+		return 1
+	}
+	encoded, err := json.Marshal(struct {
+		ContractVersion  int    `json:"contractVersion"`
+		TerraformVersion string `json:"terraformVersion"`
+		Platform         string `json:"platform"`
+		PatchSHA256      string `json:"patchSha256"`
+	}{2, version.String(), runtime.GOOS + "_" + runtime.GOARCH, NativePolicyPatchSHA256})
+	if err != nil {
+		return 1
+	}
+	c.Ui.Output(string(encoded))
+	return 0
+}
